// Preprocessable C (PreC):
// Following changes to C99:
// - uses the C preprocessor with no changes
// - can use ``c_include'' to use C headers, full C ABI compatibility is preserved
// - to refer to typedef'ed types from a ``c_include'' use @Typename
// - full list of primitive types: bool, u8, i8, u16, i16, u32, i32, u64, i64, f32, f64
// - NO type coercion at all, must explicitly cast
// - constness by default, ``mut'' to mutate
// - all values are zero-initialized by default
// - type casts and all syntactically similar operations now use angular brackets:
//    - type casts <type>expression
//    - compound literals <type> { ... }
//    - function literals <type> ${ ... }

// backport from C29: declaration in if statement:
//   if (int val = some_func; val >= 0)
//     printf("VALUE: %d\n", val);
//   else
//     printf("ERROR CODE: %d\n", -val);
// the declaration allows multiple variables
// if the expression is ommitted, then the LAST variable will be used as the clasue by itself
// also works for ``switch'' statements


// Somewhat of a backport from C29:
// TODO: anonymous structurally typed structs that are translated to a tag struct that is lazily defined:
// - tuple(i32 x, i32 y)
// - tuple_anon(i32, i32) [equivalent to: tuple(i32 _1, i32 _2)]
// TODO: A set best-effort typeof-style passes:
// - typeof(...) [forward to C compiler if can't determine]
// - tupleof<some_struct_type> [error if can't determine]
// - tupleof_anon<some_struct_type>
// - First the typeof pass, then the other two passes

// backport from C23: typeof operator (warning: it will be forwarded to the compiler if it can not be resolved because it involves C library-imported identifiers)

// switch statement auto-inserts ``break;'' at the end of each case.
// cases and default REQUIRE braces (you can omit them if it's only one statement), can use ``fall"" to stop the break auto-inserting:
// switch (x) {
//  case 1: {code; code;} fall;
//  case 2: {code; code;}
//  default: {
//    code;
//    code;
//  }

// - no typedef, explicit type definition syntax:
//      type struct vector = { i32 x, y; };
//      MUST be referred to as ``struct vector''
// - Declarations can NOT be empty now
// - The only storage classes are none, static and extern. Storage classes can only appear in declarations at the top level and in blocks.
// - for type aliases, use macros #define Vector struct vector
// - Parentheses allowed in type names in a lot more places, no erroring out stupidly
// - Types go all before the variable name: int& [5] a;
// - trailing commas allowed everywhere reasonable

// - New operators: method call
//    val..met(args) is equivalent to val.met(&val, args)
//    val->.met(args) is equivalent to val->met(val, args)
//    Suffice to say, if val is a non-reentrant expression you asked for trouble, don't blame me xD

// - Structure constdata, example:
//     type struct A = { i32 x; } constdata { i32 my_constant = 99; };
//     struct A myA = { .x = 5 };
//     myA.x; //evaluates to 5
//     myA.my_constant; //evaluates to 99
// constdata variables are actually constants that are accessed like a member of the struct and have the same scope as the type.
// in conjunction with method call operators, you can achieve comfy statically dispatched methods
// TODO: make constdata functions that take local types work (requires completing the above tupleof and typeof TODO)

// - operators are now overloading-free:
//      | -> BOR
//      ^ -> BXOR
//      + (unary) -> [ELIMINATED]
//      ~ (bitwise) -> BNOT
//      - (unary) -> ~
//      & (bitwise) -> BAND
//      Reference operator: &
//      Dereference operator: ^
// - +=, *=, etc, all gone
// - Gone: pre/post increment/decrement --, ++
// - keywords gone for obvious reasons: auto, register, _Imaginary, _Complex



// Parameter names used for initialiation, but otherwise discarded from the type as in regular C
mut i32 (&)(i32 a, i32 b) add = ${ return a+b; };

// Have to use a new type of code-valued compound literal because no parameter names specified
i32 (&)(i32, i32) sub = <i32 (&)(i32 a, i32 b)> ${ return a-b; };

i32 (&)(void) main = ${
    i32 x = sub(1, 3); // value: -2

    mut i32 y = add(1, 3); // value: 4

    // redefine add to multiply by two after adding
    add = <i32 (&)(i32 j, i32 k)> ${ return 2*(j+k); };

    y = add(1, 3); // value: 8

    return 0;
};
