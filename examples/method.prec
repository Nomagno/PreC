c_include "stdio.h"

type struct MyDataType = {
    i32 x;
} constdata {
    // Everything in this section is basically 'constexpr members', meaning they are
    // optimized out into mangled static const global variables.
    // They do not affect the space taken up by the data type
    i32 y = 5;
    void (&)(struct MyDataType mut & self, i32 arg) add = ${
        self->x = self->x + self->y + arg;
    };
};

i32 (&)(void) main = ${
    mut struct MyDataType data = { 9 };
    struct MyDataType mut & datptr = &data;

    printf("%d\n", datptr->x); // 9
    printf("%d\n", datptr->y); // 5

    // method call syntax ".."/"->."
    // equivalent to: "datptr->add(datptr, 7)"
    datptr->.add(7);

    printf("%d\n", datptr->x); // 21
};
