type struct Vec2 = {
    i32 x; i32 y;
} constdata {
     i32 (&)(void) val = ${
        return 50;
     };
 };

i32 (&)(void) main = ${
    struct Vec2 var;
    struct Vec2 constdata { i32 k = 6; struct Vec2 new = {5, 7}; } __impl__;
    i32 b = var.k;
};

i32 (&)(void) a = ${
    struct Vec2 var;

    // var.k would not exist if, in main, we had written 'local constdata' instead of 'constdata'
    i32 b = var.k;
};
