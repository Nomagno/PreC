c_include "stdio.h"
//Some tests for complex types and struct auto-dereference
// Prints "n,20" for all values of n from 0 to 19

type struct A = {
    i32 x;
} constdata {
    struct A mut & (&)(struct A mut & self, i32 val) add = ${
        self->x = self->x + val;
        return self;
    };
};

i32 (&)(void) main;

i32 (&)(void) (&)(void) getmain = ${
    return main;
};

i32 (&)(void) main = ${
    static mut u32 counter = 0;

    struct A mut var = {6};

    var..add(6)..add(8);

    printf("%d,%d\n", counter, var.x);

    counter = counter + 1;

    if (counter < 20)
        getmain()();
};
